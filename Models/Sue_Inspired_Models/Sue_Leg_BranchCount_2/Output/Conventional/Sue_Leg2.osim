							</objects>
							<groups />
						</PathWrapSet>
					</GeometryPath>
					<!--Maximum isometric force that the fibers can generate-->
					<max_isometric_force>10000</max_isometric_force>
					<!--Optimal length of the muscle fibers-->
					<optimal_fiber_length>0.29999999999999999</optimal_fiber_length>
					<!--Resting length of the tendon-->
					<tendon_slack_length>0.69999999999999996</tendon_slack_length>
					<!--Angle between tendon and fibers at optimal fiber length expressed in radians-->
					<pennation_angle_at_optimal>0</pennation_angle_at_optimal>
					<!--Assumed initial fiber length if none is assigned.-->
					<default_fiber_length>0.29999999999999999</default_fiber_length>
